NODE_ENV=development
PORT=3000
# رابط قاعدة بيانات نيون (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# مفاتيح الميزات (كلها معطلة افتراضياً، ولا تُفعَّل إلا بالقيمة true حرفياً)
# العروض التجريبية الوهمية في demo/demo-offers.js — للتطوير والعرض فقط، لا تفعّلها في الإنتاج
DEMO_MODE=false
# الاشتراك المدفوع — لا تفعّله قبل ربط بوابة دفع حقيقية والتحقق من المعاملة في الخادم
PAYMENTS_ENABLED=false
# رادار التنبيهات — لا تفعّله قبل ربط مزود إرسال فعلي (واتساب/تليغرام) ومهمة مراقبة دورية
ALERTS_DELIVERY_ENABLED=false

# مفتاح مزود البحث سيربر (serper.dev). بدونه يعود البحث الحي إلى كشط ياهو غير المضمون.
# لا تضع المفتاح الحقيقي هنا؛ أضفه في لوحة رندر ضمن متغيرات البيئة فقط.
SERPER_API_KEY=

# اقتصاديات البحث (القيم الافتراضية محافظة لتناسب الرصيد المجاني؛ ارفعها بعد شراء باقة)
# مدة حفظ النتائج المشتركة بالساعات
CACHE_TTL_HOURS=12
# سقف الأرصدة اليومي للموقع كله (كل بحث جديد = 4 أرصدة)
DAILY_CREDIT_BUDGET=200
# عدد عمليات البحث الجديدة شهرياً لكل متصفح (النتائج المحفوظة بلا حد)
FREE_NEW_SEARCHES_PER_MONTH=30
SUBSCRIBER_NEW_SEARCHES_PER_MONTH=100
# عدد أشهر عمليات البحث التي تُحدَّث ليلاً
REFRESH_TOP_N=25
# رمز سري طويل (24 حرفاً على الأقل) للتحديث الليلي؛ نفسه يوضع في أسرار غيت‌هب باسم REFRESH_TOKEN
ADMIN_REFRESH_TOKEN=

# تسجيل الدخول بحساب غوغل: معرّف تطبيق الويب من منصة غوغل السحابية (عام وليس سراً)
GOOGLE_CLIENT_ID=
# رابط الموقع العام (يستخدم لروابط العودة والإشعار من بوابة الدفع)
PUBLIC_SITE_URL=https://iraq-smart-finder.onrender.com

# بوابة كي كارد. افتراضياً البيئة التجريبية؛ ضع رابط بيئة الإنتاج الذي تعطيك إياه كي كارد عند الإطلاق
QICARD_API_BASE=https://uat-sandbox-3ds-api.qi.iq/api/v1
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_TERMINAL_ID=
# اختياري: المفتاح العام لبوابة كي كارد بصيغة PEM للتحقق من توقيع الإشعارات (يُطلب من دعم كي كارد)
QICARD_WEBHOOK_PUBLIC_KEY=
SUBSCRIPTION_PRICE_IQD=1000
SUBSCRIPTION_DAYS=30
# لا يعمل الاشتراك إلا مع PAYMENTS_ENABLED=true وكل إعدادات كي كارد وغوغل أعلاه
